int setSup(void)
{

    int rc;

    __asm( " SYSSTATE ARCHLVL=2\n"
           " MODESET MODE=SUP,KEY=ZERO"
         : "=NR:r15"(rc)
         :
         : "r0", "r1", "r14", "r15" );

    return rc;

}

int setProb(void)
{

    int rc;

    __asm( " SYSSTATE ARCHLVL=2\n"
           " MODESET MODE=PROB,KEY=NZERO"
         : "=NR:r15"(rc)
         :
         : "r0", "r1", "r14", "r15");

    return rc;

}

int reserveIndex(eLxList *ELxList)
{

    int rc;

    __asm(" LXRES ELXLIST=0,SYSTEM=YES,REUSABLE=YES,MF=L"
          : "DS"(lxres_in));

    lxres_in = lxres_out;

    setSup();

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " LXRES ELXLIST=%[list],SYSTEM=YES,REUSABLE=YES,"
          "MF=(E,(%[pl]))\n"
          :        "=NR:r15"(rc)
          : [list] "m"(ELxList->eLxCount),
            [pl]   "r"(&lxres_in)
          : "r0", "r1", "r14", "r15");

    setProb();

    return rc;

}

int setAuth(unsigned short int *axValue)
{

    int rc;

    setSup();

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " AXSET AX=(%[axv])\n"
          :        "=NR:r15"(rc)
          : [axv] "r"(*axValue)
          : "r0", "r1", "r14", "r15");

    setProb();

    return rc;

}

int setEstaex(unsigned int *ep,
              char *wrk)
{

    int rc;

    __asm(" ESTAEX 0,MF=L"
          : "DS"(estaex_in));

    estaex_in = estaex_out;

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " ESTAEX (%[exitaddr]),PARAM=%[workaddr],"
          "MF=(E,(%[pl]))\n"
          :           "=NR:r15"(rc)
          : [exitaddr] "r"(*ep),
            [workaddr] "m"(wrk),
            [pl]      "r"(&estaex_in)
          : "r0", "r1", "r14", "r15");

    return rc;

}

int loadProgram(char *module,
                unsigned int *ep)
{

    int rc;

    __asm(" LOAD EPLOC=0,LOADPT=0,SF=L"
          : "DS"(load_in));

    load_in = load_out;

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " LOAD EPLOC=(%[pgmname]),LOADPT=(%[pgmaddr]),"
          "SF=(E,(%[pl]))\n"
          :           "=NR:r15"(rc),
            [pgmaddr] "=r"(*ep)
          : [pgmname] "r"(module),
            [pl]      "r"(&load_in)
          : "r0", "r1", "r14", "r15");

    return rc;

}

int createEntryTable(tkList *TkList,
                     unsigned int ep)
{

    int rc, etplen, etpc1off, token;

    unsigned char   etparm[256], *etaddr;

    __asm("         SYSSTATE ARCHLVL=2\n"
          "         IEABRCX DEFINE\n"
          "         PUSH USING\n"
          "         DROP\n"
          "         BALR  14,0\n"
          "         USING *,14\n"
          "         J     SETPARM\n"
          "ETPARMS  ETDEF TYPE=INITIAL\n"
          "ETPC1    ETDEF TYPE=ENTRY,"
          "ROUTINE=0,"
          "AKM=0,"
          "SSWITCH=YES,"
          "SASN=NEW,"
          "PC=STACKING\n"
          "         ETDEF TYPE=FINAL\n"
          "ETPLEN   equ   *-ETPARMS\n"
          "ETPC1OFF equ   ETPC1-ETPARMS\n"
          "SETPARM  LA    %[plen],ETPLEN\n"
          "         LA    %[p1off],ETPC1OFF\n"
          "         MVC   0(ETPLEN,%[parm]),ETPARMS\n"
          "         DROP\n"
          "         POP USING"
          : [plen]  "=r"(etplen),
            [p1off] "=r"(etpc1off)
          : [parm]  "r"(etparm),
            [ep]    "r"(ep)
          : "r0", "r1", "r14", "r15");

    etaddr = etparm + etpc1off;

    __asm("         SYSSTATE ARCHLVL=2\n"
          "         IEABRCX DEFINE\n"
          "         ETDEF TYPE=SET,"
          "ETEADR=(%[addr]),"
          "ROUTINE=(%[ep]),"
          "AKM=0,"
          "SSWITCH=YES,"
          "SASN=NEW,"
          "PC=STACKING\n"
          :
          : [addr] "r"(etaddr),
            [ep]   "r"(ep)
          : );

    setSup();

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " ETCRE ENTRIES=(%[parm])"
          :         "=NR:r0"(token),
                    "=NR:r15"(rc)
          : [parm]  "r"(etparm)
          : "r0", "r1", "r14", "r15");

    setProb();

    if (rc == 0)
    {
       TkList->tkValue = token;
    }

    return rc;

}

int connectEntryTable(eLxList *ELxList,
                      tkList *TkList)
{

    int rc;

    __asm(" ETCON TKLIST=0,LXLIST=0,MF=L"
          : "DS"(etcon_in));

    etcon_in = etcon_out;

    setSup();

    __asm(" SYSSTATE ARCHLVL=2\n"
          " IEABRCX DEFINE\n"
          " ETCON ELXLIST=(%[lx]),TKLIST=(%[tk]),"
          "MF=(E,(%[pl]))\n"
          : "=NR:r15"(rc)
          : [lx] "r"(&ELxList->eLxCount),
            [tk] "r"(&TkList->tkCount),
            [pl] "r"(&etcon_in)
          : "r0", "r1", "r2", "r14", "r15");

    setProb();

    return rc;

}

int createNameTokenPair(const int *level,
                        const char *name,
                        unsigned char *token,
                        const int *persist)
{

    int rc;

    setSup();

    IEANTCR(level,
            name,
            token,
            persist,
            &rc);

    setProb();

    return rc;

}

int createTask(const int *Program_name_length,
               const char *Program_name,
               const int *Argument_length,
               const char *Argument,
               const unsigned int *Exit_routine_address,
               const unsigned int *Exit_parameter_list_address)
{

    int return_value, return_code, reason_code;

    BPX1ATM(Program_name_length,
            Program_name,
            Argument_length,
            Argument,
            Exit_routine_address,
            Exit_parameter_list_address,
            &return_value,
            &return_code,
            &reason_code);

    return return_value;

}

int waitTask(int *Process_ID,
             const int *Options,
             int *Status_field_address)
{

    int return_value, return_code, reason_code;

    BPX1WAT(Process_ID,
            Options,
            Status_field_address,
            &return_value,
            &return_code,
            &reason_code);

    return return_value;

}

int setDubThread(const int *Dub_setting)
{

    int return_value, return_code, reason_code;

    BPX1SDD(Dub_setting,
            &return_value,
            &return_code,
            &reason_code);

    return return_value;

}

int getSocket(const int *Domain,
              const int *Type,
              const int *Protocol,
              const int *Dimension,
              long long *Socket_vector)
{

    int return_value, return_code, reason_code;

    BPX1SOC(Domain,
            Type,
            Protocol,
            Dimension,
            Socket_vector,
            &return_value,
            &return_code,
            &reason_code);

    return return_value;

}

int setSocket(int *Socket,
              const int *Operation,
              const int *Level,
              const int *Option_name,
              const int *Option_data_length,
              const char *Option_data)
{

    int return_value, return_code, reason_code;

    BPX1OPT(Socket,
            Operation,
            Level,
            Option_name,
            Option_data_length,
            Option_data,
            &return_value,
            &return_code,
            &reason_code);

    return return_value;

}
