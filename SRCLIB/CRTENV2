#include <kernelh.h>
#include <string.h>

int main()
{
 int rc;
 int Process_ID;
 int Status_data = 0;
 int *Status_field_address = &Status_data;
 const int Options = 0;
 const int Program_name_length = 7;
 const char *Program_name = "ZNBTEST ";
 const int Argument_length = 4;
 const char *Argument = "ABCD";
 const unsigned int Exit_routine_address = 0;
 const unsigned int Exit_parameter_list_address = 0;

 printf("Iniciando o zNetBridge v1.0");

 rc = createTask(&Program_name_length,
                 Program_name,
                 &Argument_length,
                 Argument,
                 &Exit_routine_address,
                 &Exit_parameter_list_address);

 if (rc == -1)
 {
    printf("Erro no attach da task");
 }
 else
 {
    Process_ID = rc;
    printf("Task %X attached com sucesso", Process_ID);
 }

 rc = waitTask(&Process_ID,
               &Options,
               Status_field_address);

 if (rc == -1)
 {
   printf("Erro no WAIT");
 }
 else
 {
   printf("Task=%X", rc);
 }

 printf("Finalizando o zNetBridge v1.0");

 return 0;
}
